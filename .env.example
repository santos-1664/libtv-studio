# Optional environment settings. Existing encrypted settings take precedence.
HOST=127.0.0.1
# In Compose, PORT changes the host port; the container remains on 3100.
PORT=3100
# Used by native Node startup. Compose persists /app/data in studio-data instead.
DATA_DIR=./data
# Set a strong password before exposing this workspace beyond your own computer.
ACCESS_PASSWORD=
# For an HTTPS reverse proxy, use the exact browser origin, without trailing slash.
# Example: APP_ORIGIN=https://studio.example.com
APP_ORIGIN=
# Keep false for local HTTP; use true behind HTTPS.
COOKIE_SECURE=false
# Optional: stable encryption key; otherwise a local key is created inside DATA_DIR.
SETTINGS_ENCRYPTION_KEY=
# Text / Agent: OpenAI-compatible API base, including /v1 or /compatible-mode/v1.
# Example format: https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Set a default model only after checking the provider's actual model list.
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=
# Bailian: HTTPS workspace origin from its console; no /api/v1 or /compatible-mode suffix.
# Example format: https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com
IMAGE_PROVIDER=bailian
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=qwen-image-3.0
# Use the same authorized Bailian workspace origin and key for video.
VIDEO_PROVIDER=bailian
VIDEO_BASE_URL=
VIDEO_API_KEY=
VIDEO_MODEL=wan2.7-t2v

# Alternative protocols: IMAGE_PROVIDER=openai with /v1 base; VIDEO_PROVIDER=ark with /api/v3 base.
